        </tr>
        <tr>
            <td>total_price</td>
            <td>DOUBLE</td>
            <td>Total harga item (price * quantity).</td>
        </tr>
        <tr>
            <td>image</td>
            <td>VARCHAR(255)</td>
            <td>Berkas gambar menu saat dibeli.</td>
        </tr>
    </tbody>
</table>

